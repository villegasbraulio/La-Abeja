# AI
AI_LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
AI_CHAT_MODEL=openai/gpt-oss-20b
AI_REASONING_MODEL=openai/gpt-oss-120b
AI_EMBEDDING_MODEL=
AI_MAX_KNOWLEDGE_RESULTS=6
AI_USE_LLM=True
AI_USE_TOOL_CALLING=True
AI_ENABLE_PGVECTOR=True
AI_EMBEDDING_DIMENSIONS=1536
AI_PROVIDER_MAX_RETRIES=2
AI_PROVIDER_RETRY_BASE_SECONDS=0.25
AI_PROVIDER_MAX_TOOL_ITERATIONS=8
# Configure these per active model/provider to enable estimated cost telemetry.
AI_INPUT_COST_PER_1M_TOKENS_USD=0
AI_OUTPUT_COST_PER_1M_TOKENS_USD=0
AI_LOG_CONSOLE_DETAILS=True
