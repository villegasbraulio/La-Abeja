MERCADOPAGO_PUBLIC_KEY=APP_USR-xxxx
VITE_MERCADOPAGO_PUBLIC_KEY=APP_USR-xxxx
MERCADOPAGO_WEBHOOK_SECRET=your-webhook-secret
MERCADOPAGO_COLLECTOR_ID=

