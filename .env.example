# Django
SECRET_KEY=your-django-secret-key-minimum-50-chars
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
FRONTEND_URL=http://127.0.0.1:3000
BACKEND_URL=http://127.0.0.1:8000
CORS_ALLOWED_ORIGINS=http://127.0.0.1:3000,http://localhost:3000
CSRF_TRUSTED_ORIGINS=http://127.0.0.1:3000,http://localhost:3000
DEMO_ADMIN_EMAIL=admin@bodegalaabeja.com.ar
DEMO_ADMIN_PASSWORD=LaAbejaAdmin2026!

# Database
# For Docker + pgvector support, prefer the Postgres URL below.
# For a lightweight local fallback outside Docker, you can still use sqlite:///db.sqlite3
DATABASE_URL=postgres://postgres:postgres@db:5432/bodega_la_abeja

# Redis + Celery
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
CELERY_TASK_ALWAYS_EAGER=False

# JWT
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=15
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# Email
SENDGRID_API_KEY=SG.xxxx
DEFAULT_FROM_EMAIL=reservas@bodegelaabeja.com.ar
DEFAULT_FROM_NAME=Bodega La Abeja

# SMS / WhatsApp
TWILIO_ACCOUNT_SID=ACxxxx
TWILIO_AUTH_TOKEN=xxxx
TWILIO_PHONE_NUMBER=+15551234567
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# Cloudinary
CLOUDINARY_CLOUD_NAME=xxxx
CLOUDINARY_API_KEY=xxxx
CLOUDINARY_API_SECRET=xxxx

# MercadoPago
MERCADOPAGO_ACCESS_TOKEN=APP_USR-xxxx
MERCADOPAGO_PUBLIC_KEY=APP_USR-xxxx
MERCADOPAGO_WEBHOOK_SECRET=your-webhook-secret

# Google OAuth
GOOGLE_CLIENT_ID=xxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=xxxx

# Feature flags
ENABLE_WHATSAPP_NOTIFICATIONS=False
ENABLE_SMS_NOTIFICATIONS=False
LOW_STOCK_ALERT_ENABLED=True

# AI
AI_LLM_PROVIDER=openai
OPENAI_API_KEY=
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
AI_CHAT_MODEL=gpt-4.1
AI_REASONING_MODEL=gpt-5.1
AI_EMBEDDING_MODEL=text-embedding-3-large
AI_MAX_KNOWLEDGE_RESULTS=6
AI_USE_LLM=True
AI_USE_TOOL_CALLING=True
AI_ENABLE_PGVECTOR=True
AI_EMBEDDING_DIMENSIONS=1536
